    "test:engineer": "node --experimental-vm-modules tests/engineer-analytics.mjs",
    "test:supported-artists": "node --experimental-vm-modules tests/supported-artists.mjs && node --experimental-vm-modules tests/supported-reporting.mjs",
    "test:documents": "node tests/documents.mjs && node --experimental-vm-modules tests/document-access.mjs",
    "test:engineer-work": "node --experimental-vm-modules tests/engineer-work.mjs",
    "test:project-invoices": "node --experimental-vm-modules tests/project-invoices.mjs",
    "test:invoicing": "node --experimental-vm-modules tests/invoicing.mjs"
  },
